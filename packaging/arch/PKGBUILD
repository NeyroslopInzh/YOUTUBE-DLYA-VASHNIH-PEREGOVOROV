pkgname=yvp-vashnie-peregovori
pkgver=1.0.0
pkgrel=1
pkgdesc="YOUTUBE VIDEOS DOWNLOAD FOR VASHNIE PEREGOVORI 2002 KRUTO COOL SOSAL — вырезка отрезков YouTube в MP4"
url="https://github.com/NeyroslopInzh/YOUTUBE-DLYA-VASHNIH-PEREGOVOROV"
arch=('x86_64')
license=('MIT')
depends=(
  'glibc'
  'zlib'
  'bzip2'
  'xz'
  'zstd'
  'gcc-libs'
  'tk'
  'ffmpeg'
)
makedepends=(
  'python'
  'python-pip'
  'python-setuptools'
  'python-wheel'
)
options=('!strip')
source=()

_app_name="YOUTUBE VIDEOS DOWNLOAD FOR VASHNIE PEREGOVORI 2002 KRUTO COOL SOSAL"
_project_root="$startdir/../.."

prepare() {
  rm -rf "$srcdir/src"
  mkdir -p "$srcdir/src"

  rsync -a \
    --exclude '.git' \
    --exclude 'build' \
    --exclude 'dist' \
    --exclude '.venv' \
    --exclude '_artifact_tmp' \
    --exclude 'release' \
    --exclude 'videos download' \
    --exclude 'logs' \
    --exclude '__pycache__' \
    --exclude '*.exe' \
    --exclude 'packaging/arch/pkg' \
    --exclude 'packaging/arch/src' \
    "$_project_root/" "$srcdir/src/"
}

build() {
  cd "$srcdir/src"
  python -m venv .build-venv
  source .build-venv/bin/activate
  python -m pip install --upgrade pip
  python -m pip install -r requirements.txt -r requirements-build.txt
  python -m PyInstaller app.spec --noconfirm
}

package() {
  cd "$srcdir/src"

  install -dm755 "$pkgdir/usr/bin"
  install -dm755 "$pkgdir/usr/share/applications"

  install -Dm755 "dist/${_app_name}" "$pkgdir/usr/bin/${pkgname}"
  install -Dm644 "$startdir/${pkgname}.desktop" \
    "$pkgdir/usr/share/applications/${pkgname}.desktop"
}
